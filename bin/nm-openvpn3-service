#!/usr/bin/python3
"""Executable entry point for the NetworkManager OpenVPN 3 service plugin."""

import os
import sys

SCRIPT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(os.path.realpath(__file__))))
for path in ("/usr/local/lib/openvpn3-kde-nm", SCRIPT_ROOT):
    if os.path.isdir(path) and path not in sys.path:
        sys.path.insert(0, path)

from openvpn3_kde_nm.nm_vpn_service import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
